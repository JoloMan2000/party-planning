# Copy this file to `.env` (git-ignored) and fill in real values.
# All backend settings have safe local-dev defaults (see
# backend/app/core/config.py) - only the SMTP block below needs real
# credentials before password-reset emails will actually be delivered.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=placeholder@example.com
SMTP_PASSWORD=placeholder-app-password
SMTP_FROM_EMAIL=no-reply@partyplanning.local

# Deep-link base URL used to build password-reset links sent by email.
PASSWORD_RESET_BASE_URL=partyplanning://reset

# Comma-separated list of user emails allowed to call the /api/v1/admin/*
# endpoints (e.g. verifying organizers). Empty = no one is an admin.
ADMIN_EMAILS=you@example.com
