# Kopiere diese Datei zu ".streamlit/secrets.toml" (lokal) bzw. trage die
# Werte im Streamlit Community Cloud Dashboard unter "Settings -> Secrets" ein.
# secrets.toml selbst wird NICHT ins Git-Repo committet (siehe .gitignore).

admin_token = "dein-geheimer-wert"

# Optional: nur nötig für die Spotify-Playlist-Funktion (siehe README).
# spotify_client_id = "deine-client-id"
# spotify_client_secret = "dein-client-secret"
# spotify_redirect_uri = "<deine-app-url>/?admin=dein-geheimer-wert"
